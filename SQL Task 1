CREATE TABLE Students(   
	 Studentid  int primary key IDENTITY(1,1) NOT NULL,
	 StudentName  varchar (250) NOT NULL,
	 Email varchar (250) NOT NULL unique,
	Country	varchar (250) NOT NULL default('Egypt'),
	 Age int check(Age>=16) NOT NULL)
 ----------------
 	 CREATE TABLE Courses(
	 CourseID  int primary key IDENTITY(1,1) NOT NULL,
	 CourseName  varchar (250) NOT NULL,
	 Category varchar (250) NOT NULL unique,
	price decimal(10,2) not null check(price>0) )
 ----------------
  	 CREATE TABLE Enrollment(
	 EnrollmentID  int IDENTITY(1,1) NOT NULL,
	 FK_Studentid int,
	 FK_CourseID int,
	foreign key (FK_Studentid) references Students   (Studentid),
	 foreign key (FK_CourseID) references Courses   (CourseID),
	  EnrollmentDate datetime not null default (getdate()),
	  	  UpdateEnrollmentDate datetime not null default (getdate()))
