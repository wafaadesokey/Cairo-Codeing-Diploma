public   class Account
{
    double Userbalance = 4500;
  
    public void Withdraw( double balance)
    {
        
        if(balance> Userbalance||balance<=0)
        {
            throw new InsufficientBalanceException("Invalid Amount for withdrow process");
        }
        Userbalance -= balance;
    }
    public void Deposit(double balance)
    {

        if (balance<=0)
        {
             throw new InsufficientBalanceException("Invalid Amount for deposit process");
        }
        Userbalance += balance;
    }
}

public class InsufficientBalanceException : Exception
{
    public InsufficientBalanceException()
    {
    }

    public InsufficientBalanceException(string msg) : base(msg)
    {
    }
    public InsufficientBalanceException(string msg, Exception inner) : base(msg, inner)
    {
    }
}
